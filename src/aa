			$('#btnUploadFatcaAndCrs').removeClass('btn-danger').addClass('btn-success'); // 上傳按鈕圖片改為success
			$("#uploadFatcaAndCrsDanger").addClass("d-none"); // 隱藏警示訊息
			$("#fatcaOption2").removeClass("is-invalid"); // 移除警示的紅色文字樣式
		};
		fatcaAndCrsUploadImg.addDanger = () => {
			$('#btnUploadFatcaAndCrs').removeClass('btn-success').addClass('btn-danger'); // 上傳按鈕圖片改為danger
		};

		fatcaAndCrsObj.setInsImg(fatcaAndCrsUploadImg.insImg)
			.setDelImg(fatcaAndCrsUploadImg.removePicture)
			.setUpdImg(fatcaAndCrsUploadImg.updateBase64ImgAfterRotation);

		const rocFatcaAndCrsObj = UploadImage().init("rocFatcaAndCrsPhotos");

		const rocFatcaAndCrsUploadImg = UploadImgDefaultScript(8001,rocFatcaAndCrsObj);

		rocFatcaAndCrsObj.setInsImg(rocFatcaAndCrsUploadImg.insImg)
			.setDelImg(rocFatcaAndCrsUploadImg.removePicture)
			.setUpdImg(rocFatcaAndCrsUploadImg.updateBase64ImgAfterRotation);
	</script>
