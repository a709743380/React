		// 客戶填寫完確認送出事件 (從申請頁面進入，會先進入客戶填寫，送出後才到經辦填寫)
		async function applyConfirm(){

			// 電子交易密碼補發
			if ($electronicPasswordArea.length > 0) {
				const isAnyChecked = $("input[name='internetPasswordOption']:checked").length > 0 || $("#voicePassword").is(":checked");

				if (!isAnyChecked) {
					$("#electronicPasswordDanger").removeClass("d-none");
					layoutPopup.init().paramer({title: '提示訊息',html: '<div>電子交易密碼補發未勾選任何項目！</div>',showCancel: false}).show();
					return false;
				}
			}

			// 款項劃撥帳號檢查
			if ($transferAccountArea.length > 0) {
				const bankCode = $transferAccountArea.find("#bankInput").attr("data-key"); // 資料會異動，.data()會緩存不使用
				const bankAccount = $transferAccountArea.find("#bankAccount").val();
				if(!bankCode){
					$transferAccountArea.find("#bankInput").addClass("is-invalid");
					layoutPopup.init().paramer({title: '提示訊息',html: '<div>請選擇交割銀行！</div>',showCancel: false}).show();
					$('#customTabCarousel_16').click();
					return false;
				}

				if(!bankAccount){
					$transferAccountArea.find("#bankAccount").addClass("is-invalid");
					layoutPopup.init().paramer({title: '提示訊息',html: '<div>請輸入銀行帳號！</div>',showCancel: false}).show();
					$('#customTabCarousel_16').click();
					return false;
				}

				const reg1 = /^\d{1,16}$/; // 匹配小於 16 碼的數字帳號
				const reg2 = /^0+$/; // 全部輸入 0
				if(!reg1.test(bankAccount) || reg2.test(bankAccount)){
					$transferAccountArea.find("#bankAccount").addClass("is-invalid");
					layoutPopup.init().paramer({title: '提示訊息',html: '<div>請輸入正確銀行帳號！</div>',showCancel: false}).show();
					$('#customTabCarousel_16').click();
					return false;
				}

				// 如果銀行代碼為永豐 807
				if(/^807/.test(bankCode)){
					// 帳號開頭不可為 341 分戶帳
					if(/^341/.test(bankAccount)){
						$transferAccountArea.find("#bankAccount").addClass("is-invalid");
						layoutPopup.init().paramer({title: '提示訊息',html: '<div>銀行帳號不可為分戶帳！</div>',showCancel: false}).show();
						$('#customTabCarousel_16').click();
						return false;
					}

					// 必需為 14 碼帳號
					if (bankAccount.length !== 14){
						$transferAccountArea.find("#bankAccount").addClass("is-invalid");
						layoutPopup.init().paramer({title: '提示訊息',html: '<div>永豐銀行請輸入14碼銀行帳號！</div>',showCancel: false}).show();
						$('#customTabCarousel_16').click();
						return false;
					}
				}
			}
			// 電話號碼
			if(isPhoneExists){

			}

			// 檢查是否有選擇 FATCA 選項，以及是否為選項值 2
			const selectedFatcaOption = $("input[name='fatcaOption']:checked").val(); // 獲取選擇的 radio 值
			if (!selectedFatcaOption) {
				$("#fatcaDanger").removeClass("d-none");
				$("#fatcaTitle").addClass("text-danger");
				layoutPopup.init().paramer({title: '提示訊息',html: '<div>請選擇 FATCA 選項！</div>',showCancel: false}).show();
				return false;
			}

			if (selectedFatcaOption == "2") {
				const fatcaImgs = fatcaAndCrsObj.getImgStorage();
				// 檢查圖片是否已上傳
				if(!fatcaImgs || fatcaImgs.length < 1){
					$('#btnUploadFatcaAndCrs').removeClass('btn-success').addClass('btn-danger'); // 上傳按鈕圖片改為danger
					$("#uploadFatcaAndCrsDanger").removeClass("d-none");
					$("#fatcaOption2").addClass("is-invalid");
					layoutPopup.init().paramer({title: '提示訊息',html: '<div>請上傳 FATCA 暨 CRS 相關文件！</div>',showCancel: false}).show();
					return false;
				}
			}

			const hasCustomerSignature = $("#divsign0 img.imgsign").attr("src") != null && $("#divsign0 img.imgsign").attr("src") !== "";
			if(!hasCustomerSignature) {
				layoutPopup.init().paramer({title: '提示訊息',html: '<div>請完成簽名！</div>',showCancel: false}).show();
				return false;
			}

			layoutPopup.init().paramer({ content: "是否確定送出？" }).show(async () => {
				UserLogScript.operationBehaviorLog(`${this.pageTitle}-確認送出(提示訊息)-點擊確認按鈕`, this.formNo);
				layoutLoading.show();
				try {
					const isSaved = await saveData();
					if(isSaved){
						const url = `@Url.Action(nextPage.Action, nextPage.Controller)/${model.ecEform.formNo}?returnUrl=${encodeURIComponent(window.location.href)}&acsn=${acsn}`;
						location.replace(url);
					}

					layoutPopup.close();
				} catch (err) {
					console.error(err);
					let errorMessage = "系統發生未知錯誤，請洽系統管理員！";
					if (err.responseJSON && err.responseJSON.message) {
						// 後端返回的錯誤訊息
						errorMessage = `伺服器錯誤：${err.responseJSON.message}`;
					} else if (err.message) {
						// JavaScript 的錯誤訊息
						errorMessage = `錯誤：${err.message}`;
					}

					layoutPopup.init().paramer({ title: "送出失敗", html: `<div>${errorMessage}！<div>`, showCancel: false }).show();
				} finally {
					layoutLoading.close();
				}
			});
		}

